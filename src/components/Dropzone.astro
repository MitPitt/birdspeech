<section
	id="drop"
	class="drop"
	tabindex="0"
	role="button"
	aria-label="Drop or upload a file"
>
	<input id="file" type="file" accept="audio/*,video/*" hidden />
	<div class="drop-inner">
		<strong class="drop-label">Drop or Upload file</strong>
		<span class="drop-label-compact">Upload file...</span>
	</div>
</section>
